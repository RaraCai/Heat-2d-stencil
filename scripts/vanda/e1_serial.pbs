
#!/bin/bash

#PBS -P YOUR_PBS_ACCOUNT
#PBS -N heat_e1_serial
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"

echo "E1 Serial Runtime Scaling"
echo "Job ID: ${PBS_JOBID}"
echo "Compute Node: $(hostname)"
echo "Start Time: $(date)"
echo "Git Commit: $(git rev-parse --short HEAD 2>/dev/null || echo unavailable)"

source /app1/ebenv

module load GCC/13.3.0
module load OpenMPI/5.0.3-GCC-13.3.0
module load CMake/3.29.3-GCCcore-13.3.0

echo
echo "Loaded Modules:"
module list

echo
echo "Compiler:"
g++ --version

echo
echo "MPI Compiler:"
which mpicxx
mpicxx --showme:version

echo
echo "CMake:"
cmake --version

mkdir -p build/vanda results/raw

echo
echo "Configuring project..."

cmake -S . -B build/vanda \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=ON

echo
echo "Building Serial target and Core tests..."

cmake --build build/vanda \
    --target stencil_serial test_core \
    --parallel 1

echo
echo "Running core tests..."

ctest --test-dir build/vanda \
    -R core_smoke --output-on-failure

echo
echo "Running E1 Serial Experiment..."

./build/vanda/stencil_serial

echo
echo "End Time: $(date)"
echo "E1 completed successfully."
