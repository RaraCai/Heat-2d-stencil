
#!/bin/bash

#PBS -P YOUR_PBS_ACCOUNT
#PBS -N heat_e3_weak
#PBS -l select=4:ncpus=72:mpiprocs=72:ompthreads=1:mem=500gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"

echo "E3 MPI Weak Scaling"
echo "Job ID: ${PBS_JOBID}"
echo "Compute Nodes and Slots:"
sort "${PBS_NODEFILE}" | uniq -c
echo "Start Time: $(date)"
echo "Git Commit: $(git rev-parse --short HEAD 2>/dev/null || echo unavailable)"

source /app1/ebenv

module load GCC/13.3.0
module load OpenMPI/5.0.3-GCC-13.3.0
module load CMake/3.29.3-GCCcore-13.3.0

# Required for the PRRTE PBS/TM launcher on Vanda.
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"

echo
echo "Loaded Modules:"
module list

echo
echo "Compiler:"
g++ --version

echo
echo "MPI Compiler:"
which mpicxx
mpicxx --showme:version

echo
echo "MPI Runtime:"
mpirun --version

echo
echo "CMake:"
cmake --version

echo
echo "GCC OpenMP CPU-only Configuration:"
echo "HEAT_ENABLE_NVHPC_GPU=OFF"
echo "CMAKE_CXX_FLAGS=-foffload=disable"

BUILD_DIR="build/vanda_e3"

mkdir -p "${BUILD_DIR}" results/raw

echo
echo "Configuring E3 CPU-only project..."

cmake -S . -B "${BUILD_DIR}" \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=ON \
    -DHEAT_ENABLE_NVHPC_GPU=OFF \
    -DCMAKE_CXX_FLAGS="-foffload=disable"

echo
echo "Building E3 targets..."

cmake --build "${BUILD_DIR}" \
    --target stencil_weak_mpi test_core test_mpi \
    --parallel 4

echo
echo "Running project tests..."

ctest --test-dir "${BUILD_DIR}" \
    --output-on-failure \
    -R '^(core_smoke|mpi_2d_domain_halo)$'

echo
echo "Archiving previous E3 results..."

ARCHIVE_DIR="results/archive/e3_${PBS_JOBID}"
mkdir -p "${ARCHIVE_DIR}"

shopt -s nullglob
OLD_RESULTS=(results/raw/e3_*.csv)

if (( ${#OLD_RESULTS[@]} > 0 )); then
    mv "${OLD_RESULTS[@]}" "${ARCHIVE_DIR}/"
fi

echo
echo "Running complete E3 MPI Weak Scaling..."

BUILD_DIR="${BUILD_DIR}" bash ./scripts/local/run_e3.sh

echo
echo "Final E3 Summary..."

"${BUILD_DIR}/stencil_weak_mpi" --summary

echo
echo "Generated E3 Results:"
ls -lh results/raw/e3_*.csv

echo
echo "Checking E3 CSV row count..."

E3_ROWS=$(($(wc -l < results/raw/e3_weak.csv) - 1))

echo "E3 configurations: ${E3_ROWS}/5"

if [[ "${E3_ROWS}" -ne 5 ]]; then
    echo "Error: E3 result CSV is incomplete." >&2
    exit 1
fi

echo
echo "End Time: $(date)"
echo "E3 Weak Scaling completed successfully."
