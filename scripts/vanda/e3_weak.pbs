#!/bin/bash

#PBS -P personal-linxi.li
#PBS -N heat_e3_weak
#PBS -l select=4:ncpus=64:mpiprocs=64:mem=16gb
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"

echo "E3 MPI Weak Scaling"
echo "Job ID: ${PBS_JOBID}"
echo "Compute Nodes:"
sort -u "${PBS_NODEFILE}"
echo "Start Time: $(date)"
echo "Git Commit: $(git rev-parse --short HEAD)"

source /app1/ebenv

module load GCC/13.3.0
module load OpenMPI/5.0.3-GCC-13.3.0
module load CMake/3.29.3-GCCcore-13.3.0

echo
echo "Compiler:"
mpicxx --version

echo
echo "MPI:"
mpirun --version

echo
echo "CMake:"
cmake --version

mkdir -p build/vanda results/raw

echo
echo "Configuring project..."

cmake -S . -B build/vanda \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=ON \
    -DMPI_CXX_COMPILER="$(command -v mpicxx)"

echo
echo "Building E3 target and tests..."

cmake --build build/vanda \
    --target stencil_weak_mpi test_core test_mpi \
    --parallel 8

echo
echo "Running project tests..."

ctest --test-dir build/vanda --output-on-failure

echo
echo "Running E3 MPI Weak Scaling Experiment..."
echo "Ranks: 1, 4, 16, 64, 256"
echo "Each rank uses a 256 x 256 local grid."

rm -f results/raw/e3_weak.csv

for ranks in 1 4 16 64 256; do
    echo
    echo "[E3] Running with ${ranks} MPI ranks..."
    mpirun -np "${ranks}" ./build/vanda/stencil_weak_mpi
done

echo
echo "E3 summary:"
./build/vanda/stencil_weak_mpi --summary

echo
echo "Results: results/raw/e3_weak.csv"
echo "End Time: $(date)"
echo "E3 completed successfully."
