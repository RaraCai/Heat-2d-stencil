#!/bin/bash

#PBS -P personal-linxi.li
#PBS -N heat_e3_weak
#PBS -l select=4:ncpus=72:mpiprocs=72:ompthreads=1:mem=8gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"

echo "E3 MPI Weak Scaling"
echo "Job ID: ${PBS_JOBID}"
echo "Compute Nodes and Slots:"
sort "${PBS_NODEFILE}" | uniq -c
echo "Start Time: $(date)"
echo "Git Commit: $(git rev-parse --short HEAD 2>/dev/null || echo unavailable)"

source /app1/ebenv

module load GCC/13.3.0
module load OpenMPI/5.0.3-GCC-13.3.0
module load CMake/3.29.3-GCCcore-13.3.0

# Ensure PBS and GCC runtime libraries are available
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"

echo
echo "PBS TM Plugin Dependencies:"
ldd /app1/ebapps/arches/flat-avx512/software/OpenMPI/5.0.3-GCC-13.3.0/lib/prte/prte_mca_plm_tm.so

echo
echo "Loaded Modules:"
module list

echo
echo "Compiler:"
g++ --version

echo
echo "MPI Compiler:"
which mpicxx
mpicxx --showme:version

echo
echo "MPI Runtime:"
mpirun --version

echo
echo "CMake:"
cmake --version

BUILD_DIR="build/vanda"
mkdir -p "${BUILD_DIR}" results/raw

echo
echo "Configuring project..."
cmake -S . -B "${BUILD_DIR}" \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=ON

echo
echo "Building project..."
cmake --build "${BUILD_DIR}" --parallel 4

echo
echo "Running project tests..."
ctest --test-dir "${BUILD_DIR}" --output-on-failure

echo
echo "Archiving previous E3 results..."
ARCHIVE_DIR="results/archive/e3_${PBS_JOBID}"
mkdir -p "${ARCHIVE_DIR}"
shopt -s nullglob
OLD_RESULTS=(results/raw/e3_*.csv)
if (( ${#OLD_RESULTS[@]} > 0 )); then
    mv "${OLD_RESULTS[@]}" "${ARCHIVE_DIR}/"
fi

echo
echo "Running complete E3 MPI Weak Scaling..."
echo "Ranks: 1, 4, 16, 64, 256"
echo "Local grid per rank: 256 x 256"
BUILD_DIR="${BUILD_DIR}" ./scripts/local/run_e3.sh

echo
echo "Final E3 Summary:"
"${BUILD_DIR}/stencil_weak_mpi" --summary

echo
echo "Generated E3 Results:"
ls -lh results/raw/e3_*.csv

echo
echo "End Time: $(date)"
echo "E3 Weak Scaling completed successfully."
