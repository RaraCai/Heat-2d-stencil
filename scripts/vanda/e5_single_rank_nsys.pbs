#!/bin/bash

#PBS -P personal-yuxuan.cai
#PBS -N e5_single_rank_nsys
#PBS -l select=1:ncpus=36:ngpus=1:mpiprocs=1:ompthreads=32
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"
ROOT="$PBS_O_WORKDIR"

source /app1/ebenv
module load GCC/13.3.0
module load OpenMPI/5.0.3-GCC-13.3.0
module load CMake/3.29.3-GCCcore-13.3.0
module load cuda12.4/nsight/12.4.1

export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
export OMP_DYNAMIC=FALSE
export OMP_NUM_THREADS=32
export OMP_PLACES=cores
export OMP_PROC_BIND=close
export OMP_TARGET_OFFLOAD=MANDATORY

EXECUTABLE="$ROOT/build/vanda_e5_gcc13/test_gpu_single_rank"

echo "========================================"
echo " E5 Single Rank GPU Profiling"
echo "========================================"

echo "Git commit: $(git rev-parse HEAD)"
echo "Job ID: ${PBS_JOBID}"
echo "Node: $(hostname)"
echo "Start: $(date)"

echo
echo "Nsight Systems:"
nsys --version

echo
echo "GPU:"
nvidia-smi -L

if [[ ! -x "$EXECUTABLE" ]]; then
    echo "ERROR: Missing GPU executable: $EXECUTABLE" >&2
    exit 1
fi

# Use a temporary working directory so profiling does not overwrite
# the existing benchmark CSV files.
PROFILE_DIR="$ROOT/results/profiling"
mkdir -p "$PROFILE_DIR"

WORK_DIR="$(mktemp -d "$HOME/e5_nsys_${PBS_JOBID}_XXXXXX")"

PROFILE_BASE="$PROFILE_DIR/e5_single_rank_${PBS_JOBID}"

echo
echo "Profiling output: $PROFILE_BASE"
echo "Temporary working directory: $WORK_DIR"

cd "$WORK_DIR"

echo
echo "Starting Nsight Systems profiling..."

nsys profile \
    --trace=cuda,osrt \
    --sample=none \
    --cpuctxsw=none \
    --force-overwrite=true \
    --output="$PROFILE_BASE" \
    mpirun \
        --map-by ppr:1:node:PE=32 \
        --bind-to core \
        --report-bindings \
        -np 1 \
        "$EXECUTABLE"

echo
echo "Profiling completed."
echo "End: $(date)"

ls -lh "${PROFILE_BASE}".nsys-rep

echo
echo "Generating Nsight statistics..."

nsys stats "${PROFILE_BASE}.nsys-rep" \
    > "${PROFILE_BASE}_stats.txt"

echo "Statistics saved:"
echo "${PROFILE_BASE}_stats.txt"

echo
echo "E5 Nsight Systems profiling completed."
