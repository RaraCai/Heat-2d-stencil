#!/bin/bash

#PBS -P personal-linxi.li
#PBS -N heat_e4_hybrid_gpu
#PBS -l select=4:ncpus=36:ngpus=1:mpiprocs=36:ompthreads=1
#PBS -l place=scatter
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"

echo "E4 MPI + OpenMP GPU Offload"
echo "Job ID: ${PBS_JOBID}"
echo "Compute Nodes and Slots:"
sort "${PBS_NODEFILE}" | uniq -c
echo "Start Time: $(date)"
echo "Git Commit: $(git rev-parse --short HEAD 2>/dev/null || echo unavailable)"

source /app1/ebenv
if [[ -n "${CUDA_MODULE:-}" ]]; then
    module load "$CUDA_MODULE"
fi
module load GCC/13.3.0
module load OpenMPI/5.0.3-GCC-13.3.0
module load CMake/3.29.3-GCCcore-13.3.0

export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
export OMP_TARGET_OFFLOAD=MANDATORY
export OMP_DYNAMIC=FALSE
export OMP_PLACES=cores
export OMP_PROC_BIND=close
export E4_MPI_BINDING=vanda

echo
echo "Loaded Modules:"
module list
echo
echo "Compiler:"
g++ --version
echo
echo "MPI Compiler:"
which mpicxx
mpicxx --showme:version
echo
echo "MPI Runtime:"
mpirun --version

echo
echo "Checking that the matching E4 CPU experiment is complete..."
if [[ ! -f results/raw/e4_hybrid.csv ]]; then
    echo "Missing results/raw/e4_hybrid.csv; run E4 CPU before E4 GPU." >&2
    exit 1
fi
cpu_summary_rows=$(($(wc -l < results/raw/e4_hybrid.csv) - 1))
if [[ "$cpu_summary_rows" -ne 15 ]] ||
   ! head -n 1 results/raw/e4_hybrid.csv | grep -q "solver_median_s"; then
    echo "E4 CPU results must contain all 15 configurations; rerun E4 CPU first." >&2
    exit 1
fi

BUILD_DIR="build/vanda_e4_gpu"
mkdir -p "$BUILD_DIR" results/raw

echo
echo "Configuring GCC OpenMP nvptx offload..."
cmake -S . -B "$BUILD_DIR" \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=ON \
    -DHEAT_OPENMP_OFFLOAD=ON

echo
echo "Building project..."
cmake --build "$BUILD_DIR" --parallel 4

echo
echo "Running project tests..."
ctest --test-dir "$BUILD_DIR" --output-on-failure

echo
echo "Running all 15 E4 CPU-matched MPI/thread configurations."
echo "MPI ranks on each node share that node's one allocated GPU."
BUILD_DIR="$BUILD_DIR" ./scripts/local/run_e4_gpu.sh

echo
echo "Generated E4 GPU results:"
ls -lh results/raw/e4_gpu.csv results/raw/e4_gpu_runs.csv
summary_rows=$(($(wc -l < results/raw/e4_gpu.csv) - 1))
run_rows=$(($(wc -l < results/raw/e4_gpu_runs.csv) - 1))
if [[ "$summary_rows" -ne 15 || "$run_rows" -ne 150 ]]; then
    echo "Error: E4 GPU CSV output is incomplete." >&2
    exit 1
fi

echo
echo "End Time: $(date)"
echo "E4 GPU Offload completed successfully."
