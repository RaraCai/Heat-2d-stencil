#!/bin/bash

#PBS -P personal-yuxuan.cai
#PBS -N e5_single_rank_gpu
#PBS -l select=1:ncpus=36:ngpus=1:mpiprocs=1:ompthreads=32
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"

source /app1/ebenv
module load GCC/13.3.0
module load OpenMPI/5.0.3-GCC-13.3.0
module load CMake/3.29.3-GCCcore-13.3.0

export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
export OMP_DYNAMIC=FALSE
export OMP_NUM_THREADS=32
export OMP_PLACES=cores
export OMP_PROC_BIND=close
export OMP_TARGET_OFFLOAD=MANDATORY

BUILD_DIR="build/vanda_e5_gcc13"
EXECUTABLE="${BUILD_DIR}/test_gpu_single_rank"

echo "========================================"
echo " E5 Single MPI Rank + Single GPU Test"
echo "========================================"
echo "Git commit: $(git rev-parse HEAD)"
echo "Job ID: ${PBS_JOBID}"
echo "Start time: $(date)"
echo "Node: $(hostname)"
echo "Allocated resources:"
sort "${PBS_NODEFILE}" | uniq -c

echo
echo "Compiler / MPI:"
g++ --version
mpicxx --showme:version
mpirun --version

echo
echo "GPU:"
nvidia-smi --query-gpu=name,compute_cap,memory.total --format=csv,noheader

if [[ ! -x "${EXECUTABLE}" ]]; then
    echo "ERROR: Missing ${EXECUTABLE}; run scripts/local/build_e5.sh first." >&2
    exit 1
fi
if ldd "${EXECUTABLE}" | grep -q 'not found'; then
    echo "ERROR: Missing dynamic library for ${EXECUTABLE}." >&2
    ldd "${EXECUTABLE}"
    exit 1
fi
if [[ -e results/raw/e5_single_rank_gpu_optimized.csv || \
      -e results/raw/e5_single_rank_gpu_optimized_runs.csv ]]; then
    echo "ERROR: Optimized single-rank result files already exist; archive them before rerunning." >&2
    exit 1
fi

mkdir -p results/raw

echo
echo "Running one MPI rank with 32 CPU threads and one NVIDIA GPU..."
mpirun \
    --map-by ppr:1:node:PE=32 \
    --bind-to core \
    --report-bindings \
    -np 1 \
    "${EXECUTABLE}"

echo
echo "Single-rank GPU diagnostic completed."
echo "End time: $(date)"
ls -lh results/raw/e5_single_rank_gpu_optimized.csv \
    results/raw/e5_single_rank_gpu_optimized_runs.csv
