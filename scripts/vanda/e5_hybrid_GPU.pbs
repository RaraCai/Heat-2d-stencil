#!/bin/bash

#PBS -P personal-linxi.li
#PBS -N heat_e5_hybrid_gpu
#PBS -l select=1:ncpus=36:ngpus=1:mpiprocs=36:ompthreads=1
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"

echo "E5 MPI + OpenMP GPU Hybrid"
echo "Job ID: ${PBS_JOBID}"
echo "Allocated nodes and slots:"
sort "${PBS_NODEFILE}" | uniq -c
echo "Start time: $(date)"
echo "Git commit: $(git rev-parse --short HEAD 2>/dev/null || echo unavailable)"

source /app1/ebenv
module load GCC/13.2.0
module load NVHPC/24.7-CUDA-12.3.0
module load OpenMPI/4.1.6-GCC-13.2.0
module load CMake/3.27.6-GCCcore-13.2.0

export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
export OMP_TARGET_OFFLOAD=MANDATORY
export OMP_DYNAMIC=FALSE
export OMP_PLACES=cores
export OMP_PROC_BIND=close

echo
echo "Loaded modules:"
module list
echo
echo "Compiler and runtime:"
nvc++ --version
mpicxx --showme:version
mpirun --version
cmake --version
echo
echo "GPU allocation:"
if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=name,compute_cap --format=csv,noheader
else
    echo "nvidia-smi unavailable; OpenMP device checks will verify GPU availability."
fi

if [[ ! -f results/raw/e4_hybrid.csv ]]; then
    echo "Missing E4 CPU baseline; run E4 CPU before E5 GPU." >&2
    exit 1
fi
cpu_rows=$(($(wc -l < results/raw/e4_hybrid.csv) - 1))
if [[ "$cpu_rows" -ne 15 ]]; then
    echo "E4 CPU baseline must contain all 15 configurations." >&2
    exit 1
fi
if [[ -e results/raw/e5_gpu.csv || -e results/raw/e5_gpu_runs.csv ]]; then
    echo "E5 result files already exist; move or remove both explicitly before submitting." >&2
    exit 1
fi

BUILD_DIR="build/vanda_gpu"
if [[ ! -x "$BUILD_DIR/stencil_hybrid_gpu" || ! -x "$BUILD_DIR/test_gpu" ]]; then
    echo "E5 binaries are missing. Run scripts/local/build_e5.sh on a login node first." >&2
    exit 1
fi

echo
echo "Running GPU correctness tests (distinct from login-node CPU/MPI CTest)..."
BUILD_DIR="$BUILD_DIR" ./scripts/local/run_e5.sh --test

echo
echo "Running the five E5 Group A configurations on one GPU."
BUILD_DIR="$BUILD_DIR" ./scripts/local/run_e5.sh

echo
echo "Generated E5 GPU results:"
ls -lh results/raw/e5_gpu.csv results/raw/e5_gpu_runs.csv
summary_rows=$(($(wc -l < results/raw/e5_gpu.csv) - 1))
run_rows=$(($(wc -l < results/raw/e5_gpu_runs.csv) - 1))
if [[ "$summary_rows" -ne 5 || "$run_rows" -ne 50 ]]; then
    echo "E5 GPU result CSVs are incomplete." >&2
    exit 1
fi

echo
echo "End time: $(date)"
echo "E5 GPU Hybrid completed successfully."
